  "cards": [
    {
      "dot": "cyan",
      "title": "请求路径",
      "items": [
        "统一信封、真实 HTTP 状态码",
        "请求登记覆盖处理器与审计写入",
        "端点权限与保险库门禁沿用现有契约"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行时路径",
      "items": [
        "初始化失败释放已创建资源",
        "信号和 HTTP 错误共享关停流程",
        "关闭 WebSocket，再排空请求和启动操作"
      ]
    },
    {
      "dot": "violet",
      "title": "数据路径",
      "items": [
        "落盘循环停止时等待进行中的写入",
        "写入失败保留脏标记并报告错误",
        "Redis 是可选缓存，SQL 为账户权威数据"
      ]
    },
    {
      "dot": "rose",
      "title": "演进边界",
      "items": [
        "现有代码仍在同一个 Go 包",
        "长任务取消 / 恢复为后续工作",
        "业务服务与存储接口按需求逐步拆分"
      ]
    }
